# =============================================================================
# Arc DevKit — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env no git.
# =============================================================================
# Token do PyPI — necessário apenas para publicar o pacote no PyPI (CI/CD)
# Gere em: https://pypi.org/manage/account/token/
TOKEN_PYPI=pypi-...

# Chave da API Anthropic — obrigatória quando COPILOT_PROVIDER=anthropic
# (o default). Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Dev Copilot — backend de IA (v0.9.0+)
# =============================================================================

# Provedor de IA usado pelo Dev Copilot (arc ask / arcdevkit copilot ask /
# Tx Debugger). Opções: anthropic (padrão) | gemini | openai | ollama
# Modo agentic com tools (arc ask --agent) só funciona com anthropic hoje.
COPILOT_PROVIDER=anthropic

# Google Gemini — obrigatório quando COPILOT_PROVIDER=gemini
# Requer: pip install arc-devkit[gemini]
# Chave: https://ai.google.dev  |  Modelos: https://ai.google.dev/gemini-api/docs/models
# Nenhum modelo default é adivinhado — defina o nome exato do modelo atual.
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenAI (GPT) — obrigatório quando COPILOT_PROVIDER=openai
# Requer: pip install arc-devkit[openai]
# Chave: https://platform.openai.com  |  Modelos: https://platform.openai.com/docs/models
# Nenhum modelo default é adivinhado — defina o nome exato do modelo atual.
OPENAI_API_KEY=
OPENAI_MODEL=

# Ollama (local/self-hosted) — obrigatório quando COPILOT_PROVIDER=ollama
# Sem API key. Requer um servidor Ollama rodando com o modelo já baixado
# (ollama pull <modelo>). Nenhum modelo default é adivinhado.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Perfil de rede — define os defaults de RPC/chain ID em arc_devkit/networks.py
# Opções: testnet (padrão) | mainnet (ainda sem RPC padrão — lança verão 2026)
# ARC_RPC_URL/ARC_CHAIN_ID abaixo, se definidos, sempre têm prioridade sobre o perfil.
ARC_NETWORK=testnet

# URL do nó RPC da Arc
# Testnet (desenvolvimento): https://arc-testnet.drpc.org
# Mainnet (produção, verão 2026): configurar quando disponível
ARC_RPC_URL=https://arc-testnet.drpc.org

# Chain ID da rede Arc
# Testnet: 5042002 (verifique na documentação oficial da Arc)
ARC_CHAIN_ID=5042002

# Chave privada da carteira — opcional
# Necessária apenas para operações que enviam transações (agentes, pagamentos)
# Formato: hex sem prefixo 0x
# ATENÇÃO: nunca use sua carteira principal aqui — crie uma carteira dedicada para testes
ARC_PRIVATE_KEY=

# Nível de log da aplicação
# Opções: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# Segurança (v0.4.7+)
# =============================================================================

# Ambiente de execução — em "production" a API exige API_KEY configurada,
# força HTTPS e envia o header Strict-Transport-Security
ENV=development

# Chave de autenticação da API REST (header X-API-Key)
# Obrigatória quando ENV=production
API_KEY=

# Teto de gas price em gwei — transações são rejeitadas acima deste valor
# Vazio = sem limite
MAX_GAS_PRICE_GWEI=

# =============================================================================
# Guardrails para agents autônomos (v0.4.7+)
# =============================================================================

# Limite de gasto diário (USDC) para ações autônomas (auto-recarga, triggers)
# Vazio = sem limite (NÃO recomendado em produção)
MAX_SPEND_PER_DAY_USDC=

# Whitelist de destinatários para transferências autônomas (separados por vírgula)
# Vazio = qualquer destino (NÃO recomendado em produção)
AGENT_ALLOWED_RECIPIENTS=

# =============================================================================
# CCTP Bridge (v0.6.0+) — arc_devkit/bridge/
# =============================================================================

# URL da API de attestation do Circle CCTP (ex.: Iris API — sandbox/produção).
# Sem valor default: a Arc ainda não tem domínio CCTP publicado, então este
# valor não é adivinhado — configure quando a Circle publicar suporte à Arc.
CCTP_ATTESTATION_API_URL=

# =============================================================================
# Dev Copilot — fonte de documentação oficial (v0.8.0+)
# =============================================================================

# URL do llms.txt oficial da Arc (docs.arc.io), usado pela tool `search_arc_docs`
# do Copilot. Sem valor default — a tool responde "not configured" até você
# apontar para a URL real publicada pela Arc.
ARC_LLMS_TXT_URL=
